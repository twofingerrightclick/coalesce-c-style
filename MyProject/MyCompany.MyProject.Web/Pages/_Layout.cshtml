@namespace MyCompany.MyProject.Web.Pages

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <style>
        :root {
            line-height: 1.5;
            font-weight: 400;
            --preferred-width: 350px;
        }

        p,
        .limit-width {
            max-width: var(--preferred-width);
        }

        body {
            font-family: "Roboto", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            margin: 0;
            display: flex;
            place-items: center;
            justify-content: center;
            min-width: 320px;
            min-height: 100vh;
            padding-bottom: 15vh;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        }

        .btn img {
            margin-right: 10px;
            height: 20px
        }

        a {
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="card rounded-4 mx-auto mt-3" style="min-width: var(--preferred-width); box-shadow: 0 8px 40px rgba(0,0,0,0.4)">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-4">
                @* <img src="/logo.svg" style="height: 1.3em; padding-right: 0.2em" /> *@

                @ViewData["Title"]
            </h3>

            @RenderBody()
        </div>
    </div>


    @RenderSection("Scripts", required: false)
</body>

</html>