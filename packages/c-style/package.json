{
  "name": "c-style",
  "version": "6.5.1-cs.1",
  "description": "Canon look for Vuetify 4 and Coalesce, through Vuetify's own SASS, defaults and theme channels.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twofingerrightclick/c-style.git",
    "directory": "packages/c-style"
  },
  "homepage": "https://github.com/twofingerrightclick/c-style#readme",
  "bugs": "https://github.com/twofingerrightclick/c-style/issues",
  "keywords": [
    "vuetify",
    "coalesce",
    "canon",
    "design-system",
    "theme",
    "vite-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons/lucide.ts",
      "default": "./src/icons/lucide.ts"
    },
    "./vite": {
      "types": "./src/vite.d.mts",
      "default": "./src/vite.mjs"
    },
    "./fonts/inter": {
      "types": "./src/styles/styles.d.ts",
      "default": "./src/fonts/inter.css"
    },
    "./settings": {
      "types": "./src/styles/styles.d.ts",
      "sass": "./src/styles/settings.scss",
      "default": "./src/styles/settings.scss"
    },
    "./styles": {
      "types": "./src/styles/styles.d.ts",
      "sass": "./src/styles/index.scss",
      "default": "./src/styles/index.scss"
    },
    "./tokens": {
      "types": "./src/styles/styles.d.ts",
      "sass": "./src/tokens.scss",
      "default": "./src/tokens.scss"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsdown && node scripts/copy-assets.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@lucide/vue": "^1.68.0",
    "culori": "^4.0.2",
    "inter-ui": "^4.1.1"
  },
  "peerDependencies": {
    "sass": "^1.80.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vue": "^3.5.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.0",
    "@types/node": "^24.0.0",
    "coalesce-vue-vuetify3": "6.5.1",
    "sass": "^1.99.0",
    "tsdown": "^0.23.5",
    "typescript": "6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.5",
    "vue": "^3.5.33",
    "vuetify": "4.3.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./icons": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./fonts/inter": {
        "types": "./dist/styles/styles.d.ts",
        "default": "./dist/fonts/inter.css"
      },
      "./settings": {
        "types": "./dist/styles/styles.d.ts",
        "sass": "./dist/styles/settings.scss",
        "default": "./dist/styles/settings.scss"
      },
      "./styles": {
        "types": "./dist/styles/styles.d.ts",
        "sass": "./dist/styles/index.scss",
        "default": "./dist/styles/index.scss"
      },
      "./tokens": {
        "types": "./dist/styles/styles.d.ts",
        "sass": "./dist/tokens.scss",
        "default": "./dist/tokens.scss"
      }
    }
  }
}
