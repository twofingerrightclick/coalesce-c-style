{
  "name": "c-style",
  "version": "0.1.0",
  "description": "Canon look for Vuetify 4 and Coalesce, through Vuetify's own SASS, defaults and theme channels.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons/lucide.ts",
      "default": "./src/icons/lucide.ts"
    },
    "./vite": {
      "types": "./src/vite.d.mts",
      "default": "./src/vite.mjs"
    },
    "./fonts/inter": {
      "types": "./src/styles/styles.d.ts",
      "default": "./src/fonts/inter.css"
    },
    "./settings": {
      "types": "./src/styles/styles.d.ts",
      "sass": "./src/styles/settings.scss",
      "default": "./src/styles/settings.scss"
    },
    "./styles": {
      "types": "./src/styles/styles.d.ts",
      "sass": "./src/styles/index.scss",
      "default": "./src/styles/index.scss"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@lucide/vue": "^1.68.0",
    "culori": "^4.0.2",
    "inter-ui": "^4.1.1"
  },
  "peerDependencies": {
    "sass": "^1.80.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vue": "^3.5.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.0",
    "@types/node": "^24.0.0",
    "coalesce-vue-vuetify3": "6.5.1",
    "sass": "^1.99.0",
    "typescript": "6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.5",
    "vue": "^3.5.33",
    "vuetify": "4.3.2"
  }
}
