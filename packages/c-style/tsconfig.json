{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.mts", "test/**/*.ts", "vitest.config.ts"]
}
