{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"], "@demo/*": ["../MyProject/MyCompany.MyProject.Web/src/*"] }
  },
  "include": [".storybook/**/*.ts", "src/**/*.ts", "src/**/*.vue", "stories/**/*.ts"]
}
